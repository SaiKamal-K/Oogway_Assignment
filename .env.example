# ==========================================
# The Lenny Growth Assistant - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="The Lenny Growth Assistant"
APP_ENV=development
DEBUG=true

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant
# For inside Docker: postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# Local LLM Provider (Ollama)
# When running on host machine: http://localhost:11434
# When running inside Docker container: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Default Provider for Chat ('ollama', 'claude', or 'openai')
DEFAULT_PROVIDER=ollama

# Optional Cloud LLM Providers
# (If omitted, system seamlessly runs 100% offline with local Ollama)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Retrieval Parameters
SIMILARITY_THRESHOLD=0.45
TOP_K_RETRIEVAL=5
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
